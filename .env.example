# Copy to .env and fill in before the event. .env is gitignored — never commit real secrets.

# --- Database (docker-compose.yml) ---
DB_NAME=playplex
DB_USER=playplex
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Host port for the container. 3306 is often taken by a locally installed MySQL.
DB_PORT=3307

# --- API ---
# At least 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# true once the event laptop serves HTTPS via mkcert (docs/07 task 7.2).
JWT_SECURE_COOKIE=false
# Only needed while the Vite dev server runs on another port; empty in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The seeded account is admin / playplex, and it must change its password on first
# sign-in (docs/07 task 4.8). Create the real staff accounts from the Staff screen.
